# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/kindred

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_32_char_minimum_random_string
JWT_EXPIRES_IN=8h

# ── Email (SMTP via Nodemailer) ────────────────────────────────────────────────
# If left empty, emails will gracefully log to console and EmailLog table
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Kindred Care <notifications@kindred.local>

# ── Demo Mode (Fast-forward clock for hackathon presentations) ─────────────────
DEMO_MODE=true

# ── AI Services (Phase 5, optional — app runs completely without these) ────────
ADAPTION_API_KEY=pt_live_xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=

